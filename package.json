{
  "name": "@saneksa/react-context-composer",
  "version": "2.2.0",
  "keywords": [
    "context compose",
    "context composer",
    "contexts",
    "react"
  ],
  "license": "MIT",
  "repository": "git@github.com:saneksa/react-context-composer.git",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "lint": "npm run typecheck && oxlint",
    "release": "npm run lint && npm run format:check && npm run compat:install && npm run test:all && standard-version && npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run && tstyche",
    "test:watch": "vitest",
    "test:types": "tstyche",
    "test:types:all": "tstyche --target '>=5.4'",
    "compat:install": "yarn --cwd compat/react17 install --frozen-lockfile && yarn --cwd compat/react19 install --frozen-lockfile",
    "test:react17": "REACT_VERSION=17 vitest run && tsc -p compat/react17 && tstyche --tsconfig ./compat/react17/tsconfig.json composer",
    "test:react19": "REACT_VERSION=19 vitest run && tsc -p compat/react19 && tstyche --tsconfig ./compat/react19/tsconfig.json",
    "test:all": "yarn test && yarn test:react17 && yarn test:react19 && yarn test:types:all"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^18",
    "react-dom": "^18",
    "rollup": "^3.29.1",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "standard-version": "^9.5.0",
    "tstyche": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^17||^18||^19"
  }
}
