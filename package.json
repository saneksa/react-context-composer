{
  "name": "@saneksa/react-context-composer",
  "version": "2.2.0",
  "keywords": [
    "context compose",
    "context composer",
    "contexts",
    "react"
  ],
  "license": "MIT",
  "repository": "git@github.com:saneksa/react-context-composer.git",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "lint": "tsc --noEmit && oxlint",
    "release": "npm run lint && npm run format:check && standard-version && npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@types/react": "^18.3.0",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^18",
    "rollup": "^3.29.1",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^17||^18||^19"
  }
}
